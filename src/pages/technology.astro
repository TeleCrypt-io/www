---
import { getEntry, render } from "astro:content";
import Page from "@/components/Page.astro";

const entry = await getEntry("page", "technology");
if (!entry) throw new Error("Missing src/content/page/technology.md");
const { Content } = await render(entry);

const meta = {
	description: entry.data.description ?? "How the transport works, and why it's secure.",
	title: entry.data.title,
};
---

<Page title={meta.title} description={meta.description} label="Technology">
	<Content />
</Page>
