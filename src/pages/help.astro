---
import Layout from '../layouts/Layout.astro';
---

<Layout title="help — TeleCrypt.io" statusFile="help">
  <div class="max-w-2xl mx-auto py-6">
    <h1 class="text-2xl font-bold mb-6 text-nvim-blue">help</h1>

    <h2 class="text-lg font-bold text-nvim-yellow mb-2"># commands</h2>
    <p class="ml-4 mb-1"><span class="font-bold text-nvim-green">:about</span>        the slogan</p>
    <p class="ml-4 mb-1"><span class="font-bold text-nvim-green">:technology</span>   how the transport works &amp; why it's secure</p>
    <p class="ml-4 mb-1"><span class="font-bold text-nvim-green">:llms</span>         machine-readable notes for agents</p>
    <p class="ml-4 mb-1"><span class="font-bold text-nvim-green">:eject</span>        how to eject your own data</p>
    <p class="ml-4 mb-1"><span class="font-bold text-nvim-green">:support</span>      contact support</p>
    <p class="ml-4 mb-1"><span class="font-bold text-nvim-green">:privacy</span>      privacy policy</p>
    <p class="ml-4 mb-1"><span class="font-bold text-nvim-green">:h</span>            this page</p>
    <p class="ml-4 mb-4"><span class="font-bold text-nvim-green">:q</span>            exit</p>

    <h2 class="text-lg font-bold text-nvim-yellow mb-2"># normal-mode keys</h2>
    <p class="ml-4 mb-1"><span class="font-bold">j</span> / <span class="font-bold">k</span>   scroll down / up</p>
    <p class="ml-4 mb-1"><span class="font-bold">g</span> / <span class="font-bold">G</span>   jump to top / bottom</p>
    <p class="ml-4 mb-1"><span class="font-bold">u</span>       go up one level (back to landing)</p>
    <p class="ml-4 mb-4"><span class="font-bold">:</span>       start a command</p>

    <p class="mt-8 text-sm text-nvim-gray">type <span class="text-nvim-yellow">u</span> to go back</p>
  </div>
</Layout>
