---
import { getEntry, render } from "astro:content";
import Page from "@/components/Page.astro";

const entry = await getEntry("page", "privacy");
if (!entry) throw new Error("Missing src/content/page/privacy.md");
const { Content } = await render(entry);

const meta = {
	description: entry.data.description ?? "What we collect, why, and who can see it.",
	title: entry.data.title,
};
---

<Page title={meta.title} description={meta.description} label="Privacy">
	<Content />
</Page>
