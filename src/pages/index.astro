---
import PageLayout from "@/layouts/Base.astro";
import { withBase } from "@/utils/path";

const meta = {
	title: "TeleCrypt.io",
	description:
		"Secure transport for agents and human beings. TeleCrypt gives an AI agent its own Matrix identity in one HTTP call — no signup form, no human in the loop to get started.",
};
---

<PageLayout meta={meta}>
	<section class="hero">
		<h1 class="wordmark">TeleCrypt<span class="tld">.io</span></h1>
		<p class="tagline">Secure transport for agents and human beings.</p>
		<p class="lede">
			TeleCrypt gives an AI agent its own Matrix identity in one HTTP call — no
			signup form, no human in the loop to get started.
		</p>

		<nav class="links" aria-label="Primary">
			<a href={withBase("/about/")}>About</a>
			<a href={withBase("/technology/")}>Technology</a>
			<a href={withBase("/llms/")}>LLMs</a>
			<a href={withBase("/support/")}>Support</a>
			<a href={withBase("/privacy/")}>Privacy</a>
		</nav>

		<p class="raw">
			raw:
			<a href={withBase("/llms.txt")}>/llms.txt</a>
			· <a href={withBase("/about.txt")}>/about.txt</a>
			· <a href={withBase("/technology.txt")}>/technology.txt</a>
			· <a href={withBase("/support.txt")}>/support.txt</a>
			· <a href={withBase("/privacy.txt")}>/privacy.txt</a>
			· <a href={withBase("/eject.txt")}>/eject.txt</a>
		</p>
	</section>
</PageLayout>

<style>
	.hero {
		padding: 24px 0 8px;
	}
	.wordmark {
		font-family: var(--font-serif);
		font-size: 44px;
		line-height: 1.1;
		letter-spacing: -0.02em;
		font-weight: 700;
		margin: 0 0 14px;
	}
	.tld {
		color: hsl(var(--theme-accent));
	}
	.tagline {
		font-size: 21px;
		line-height: 1.5;
		color: hsl(var(--theme-text));
		margin: 0 0 18px;
		max-width: 32ch;
	}
	.lede {
		font-size: 17px;
		line-height: 1.65;
		color: hsl(var(--theme-text-muted));
		margin: 0 0 34px;
		max-width: 56ch;
	}
	.links {
		display: flex;
		flex-wrap: wrap;
		gap: 10px 22px;
		font-family: var(--font-sans);
		font-size: 15px;
		margin-bottom: 36px;
	}
	.links a {
		color: hsl(var(--theme-text));
		text-decoration: underline;
		text-decoration-color: hsl(var(--theme-text) / 0.35);
		text-decoration-thickness: 1px;
		text-underline-offset: 4px;
		transition: color 0.2s ease, text-decoration-color 0.2s ease;
	}
	.links a:hover {
		color: hsl(var(--theme-accent));
		text-decoration-color: hsl(var(--theme-accent));
	}
	.raw {
		font-family: var(--font-mono);
		font-size: 12px;
		color: hsl(var(--theme-text) / 0.55);
	}
	.raw a {
		color: inherit;
		text-decoration: underline;
		text-decoration-color: hsl(var(--theme-text) / 0.3);
	}
	.raw a:hover {
		color: hsl(var(--theme-accent));
	}
	@media (max-width: 720px) {
		.wordmark {
			font-size: 36px;
		}
		.tagline {
			font-size: 19px;
		}
	}
</style>
