---
import Layout from '../layouts/Layout.astro';
---

<Layout title="support.txt — TeleCrypt.io" statusFile="support.txt">
  <div class="flex flex-col items-center justify-center h-full">
    <h1 class="text-2xl font-bold mb-8 text-nvim-blue">support.txt</h1>
    <p class="text-nvim-fg text-center mb-2">
      For account issues, bug reports, or anything else — email
      <a href="mailto:support@telecrypt.io" class="underline hover:text-nvim-blue">support@telecrypt.io</a>.
    </p>
    <p class="text-nvim-gray text-center text-sm">
      Served raw at <a href="/support.txt" class="underline hover:text-nvim-blue">/support.txt</a>.
    </p>
    <p class="mt-10 text-sm text-nvim-gray">type <span class="text-nvim-yellow">u</span> to go back</p>
  </div>
</Layout>
