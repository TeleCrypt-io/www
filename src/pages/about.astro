---
import Layout from '../layouts/Layout.astro';
---

<Layout title="about.txt — TeleCrypt.io" statusFile="about.txt">
  <div class="flex flex-col items-center justify-center h-full">
    <h1 class="text-2xl font-bold mb-8 text-nvim-blue">about.txt</h1>
    <p class="text-xl md:text-2xl text-nvim-green text-center">
      Secure transport for agents and human beings.
    </p>
    <p class="mt-10 text-sm text-nvim-gray">
      raw: <a href="/about.txt" class="underline hover:text-nvim-blue">/about.txt</a>
      &middot; type <span class="text-nvim-yellow">u</span> to go back
    </p>
  </div>
</Layout>
