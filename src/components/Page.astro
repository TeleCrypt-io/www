---
import PageLayout from "@/layouts/Base.astro";

interface Props {
	title: string;
	description?: string;
	label: string;
}

const { title, description, label } = Astro.props;
const meta = { title, description: description ?? title };
---

<PageLayout meta={meta}>
	<section class="page" aria-labelledby="page-label">
		<div class="section-label" id="page-label">{label}</div>
		<div class="prose">
			<slot />
		</div>
	</section>
</PageLayout>

<style>
	.page {
		margin-bottom: 64px;
	}
	.prose {
		font-family: var(--font-serif);
		font-size: 17.5px;
		line-height: 1.75;
		color: hsl(var(--theme-text));
		max-width: var(--reading-width);
	}
	.prose :global(h2) {
		font-size: 20px;
		font-weight: 700;
		margin: 34px 0 10px;
		color: hsl(var(--theme-text));
	}
	.prose :global(h2:first-child) {
		margin-top: 0;
	}
	.prose :global(p) {
		margin: 0 0 22px;
		text-wrap: pretty;
	}
	.prose :global(p:last-child) {
		margin-bottom: 0;
	}
	.prose :global(a) {
		color: hsl(var(--theme-text));
		text-decoration: underline;
		text-decoration-color: hsl(var(--theme-text) / 0.35);
		text-underline-offset: 3px;
		transition: color 0.2s ease, text-decoration-color 0.2s ease;
	}
	.prose :global(a:hover) {
		color: hsl(var(--theme-accent));
		text-decoration-color: hsl(var(--theme-accent));
	}
	.prose :global(code) {
		font-family: var(--font-mono);
		font-size: 0.9em;
		background: hsl(var(--theme-text) / 0.08);
		padding: 1px 5px;
		border-radius: 4px;
	}
	.prose :global(pre) {
		background: hsl(var(--theme-text) / 0.05);
		padding: 14px 16px;
		border-radius: 8px;
		overflow-x: auto;
		margin: 0 0 22px;
	}
	.prose :global(pre code) {
		background: none;
		padding: 0;
	}
	@media (max-width: 720px) {
		.prose {
			font-size: 17px;
			line-height: 1.7;
		}
	}
</style>
