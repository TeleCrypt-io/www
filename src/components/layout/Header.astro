---
import { menuLinks, siteConfig } from "@/site-config";
import { withBase } from "@/utils/path";

const url = new URL(Astro.request.url);
const homePath = withBase("/");
const isHome = url.pathname === homePath || url.pathname === withBase("");

const visibleMenuLinks = menuLinks.filter((link) => link.path !== "/");

const isActive = (path: string) => {
	if (path.includes("#")) return false;
	const target = withBase(path);
	if (path === "/") return url.pathname === target;
	return url.pathname === target || url.pathname.startsWith(target);
};
---

<header class:list={["site-header", { "site-header--home": isHome }]} id="main-header">
	{
		isHome ? (
			<h1 class="brand">
				<a href={homePath} class="brand-link">
					TeleCrypt<span class="tld">.io</span>
				</a>
			</h1>
		) : (
			<a href={homePath} class="wordmark">
				{siteConfig.title}
			</a>
		)
	}
	<nav class="nav" aria-label="Primary">
		{
			visibleMenuLinks.map((link) => (
				<a
					aria-current={isActive(link.path) ? "page" : false}
					class:list={[{ active: isActive(link.path) }]}
					data-astro-prefetch
					href={withBase(link.path)}
				>
					{link.title}
				</a>
			))
		}
	</nav>
</header>

<style>
	.site-header {
		display: flex;
		align-items: baseline;
		justify-content: space-between;
		gap: 24px;
		margin-bottom: 28px;
	}
	.site-header--home {
		align-items: center;
		margin-bottom: 20px;
	}
	.wordmark {
		font-family: var(--font-serif);
		font-size: 17px;
		font-weight: 500;
		letter-spacing: -0.01em;
		color: hsl(var(--theme-text));
		transition: color 0.2s ease;
	}
	.wordmark:hover {
		color: hsl(var(--theme-accent));
	}
	.brand {
		margin: 0;
		font-size: inherit;
		font-weight: inherit;
	}
	.brand-link {
		font-family: var(--font-sans);
		font-size: clamp(32px, 4.5vw, 44px);
		line-height: 1.02;
		letter-spacing: -0.045em;
		font-weight: 700;
		font-variation-settings: "wght" 700;
		color: hsl(var(--theme-text));
		transition: opacity 0.2s ease;
	}
	.brand-link:hover {
		opacity: 0.85;
	}
	.tld {
		color: hsl(var(--theme-accent));
	}
	.nav {
		display: flex;
		align-items: baseline;
		gap: 22px;
		font-family: var(--font-sans);
		font-size: 13.5px;
		color: hsl(var(--theme-text) / 0.72);
	}
	.nav a {
		display: inline-block;
		position: relative;
		padding-bottom: 3px;
		transition: color 0.2s ease;
	}
	.nav a::after {
		content: "";
		position: absolute;
		left: -3px;
		right: -3px;
		bottom: 0;
		height: 1px;
		background: transparent;
	}
	.nav a:hover {
		color: hsl(var(--theme-accent));
	}
	.nav a.active {
		color: hsl(var(--theme-text));
	}
	.nav a.active::after {
		background: hsl(var(--theme-accent));
	}

	@media (max-width: 720px) {
		.site-header {
			margin-bottom: 20px;
			flex-wrap: wrap;
			row-gap: 12px;
		}
		.site-header--home {
			margin-bottom: 16px;
		}
		.brand-link {
			font-size: clamp(28px, 8vw, 36px);
		}
		.nav {
			gap: 16px;
			font-size: 13px;
			flex-wrap: wrap;
		}
		.nav a {
			padding-top: 4px;
		}
	}

	@media (max-width: 420px) {
		.wordmark {
			font-size: 16px;
		}
		.nav {
			gap: 14px;
			font-size: 12.5px;
		}
	}
</style>
